+const char* TrackingStateLabel(const int state)
+{
+    switch(state)
+    {
+        case -1: return "SYSTEM NOT READY";
+        case 0: return "WAITING FOR CAMERA";
+        case 1: return "INITIALIZING";
+        case 2: return "TRACKING OK";
+        case 3: return "TRACKING WEAK";
+        case 4: return "TRACKING LOST";
+        case 5: return "TRACKING OK (KLT)";
+        default: return "UNKNOWN STATE";
+    }
+}
+
+const char* TrackingGuidance(const int state)
+{
+    switch(state)
+    {
+        case 1: return "Move slowly and keep textured objects visible in both lenses";
+        case 3: return "Slow down; point both lenses at a previously mapped textured area";
+        case 4: return "Return to a known view; avoid blank walls, blur and lens occlusion";
+        default: return "Green points are tracked features; the 3D window is a sparse map";
+    }
+}
+
+cv::Scalar TrackingStateColor(const int state)
+{
+    if(state == 2 || state == 5) return cv::Scalar(40, 220, 40);
+    if(state == 3 || state == 1) return cv::Scalar(0, 200, 255);
+    if(state == 4) return cv::Scalar(40, 40, 255);
+    return cv::Scalar(210, 210, 210);
+}
