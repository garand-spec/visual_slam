@@ -56,6 +56,10 @@
 #include <opencv2/highgui/highgui.hpp>
 #include <opencv2/features2d/features2d.hpp>
 #include <opencv2/imgproc/imgproc.hpp>
+#ifdef ORB_SLAM3_USE_CUDA
+#include <opencv2/core/cuda.hpp>
+#include <opencv2/cudafeatures2d.hpp>
+#endif
 #include <vector>
 #include <iostream>
 
@@ -1093,6 +1097,65 @@ namespace ORB_SLAM3
         Mat image = _image.getMat();
         assert(image.type() == CV_8UC1 );
 
+#ifdef ORB_SLAM3_USE_CUDA
+        // CUDA ORB keeps the expensive FAST/BRIEF extraction on the Thor GPU.
+        // The CPU implementation below remains the compatibility fallback.
+        if (cv::cuda::getCudaEnabledDeviceCount() > 0)
+        {
+            try
+            {
+                if (!mpCudaORB)
+                    mpCudaORB = cv::cuda::ORB::create(
+                        nfeatures, static_cast<float>(scaleFactor), nlevels,
+                        EDGE_THRESHOLD, 0, 2, cv::ORB::HARRIS_SCORE, PATCH_SIZE, minThFAST);
+                mCudaImage.create(image.size(), image.type());
+                mCudaImage.upload(image, mCudaStream);
+                mpCudaORB->detectAndComputeAsync(
+                    mCudaImage, cv::cuda::GpuMat(), mCudaKeypoints,
+                    mCudaDescriptors, false, mCudaStream);
+                mCudaDescriptors.download(mCudaHostDescriptors, mCudaStream);
+                mCudaStream.waitForCompletion();
+                mpCudaORB->convert(mCudaKeypoints, mvCudaKeypoints);
+
+                if (!mvCudaKeypoints.empty() &&
+                    mCudaHostDescriptors.rows == static_cast<int>(mvCudaKeypoints.size()) &&
+                    mCudaHostDescriptors.cols == 32 && mCudaHostDescriptors.type() == CV_8UC1)
+                {
+                    int monoCount = 0;
+                    int stereoCount = 0;
+                    for (const cv::KeyPoint& kp : mvCudaKeypoints)
+                    {
+                        if (kp.pt.x >= vLappingArea[0] && kp.pt.x <= vLappingArea[1])
+                            ++stereoCount;
+                        else
+                            ++monoCount;
+                    }
+
+                    const int total = monoCount + stereoCount;
+                    _keypoints.resize(total);
+                    _descriptors.create(total, 32, CV_8U);
+                    cv::Mat outputDescriptors = _descriptors.getMat();
+                    int monoIndex = 0;
+                    int stereoIndex = total - 1;
+                    for (int i = 0; i < total; ++i)
+                    {
+                        const cv::KeyPoint& kp = mvCudaKeypoints[i];
+                        const int outIndex = (kp.pt.x >= vLappingArea[0] && kp.pt.x <= vLappingArea[1])
+                            ? stereoIndex-- : monoIndex++;
+                        _keypoints[outIndex] = kp;
+                        mCudaHostDescriptors.row(i).copyTo(outputDescriptors.row(outIndex));
+                    }
+                    return monoCount;
+                }
+            }
+            catch (const cv::Exception& e)
+            {
+                std::cerr << "[ORBextractor] CUDA ORB failed, using CPU fallback: "
+                          << e.what() << std::endl;
+            }
+        }
+#endif
+
         // Pre-compute the scale pyramid
         ComputePyramid(image);
 
